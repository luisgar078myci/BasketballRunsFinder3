ImageMetadata:1*beh9PfQyV-d5jtlM3eNFmw.png"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:aca2693c6acf_2":{"__typename":"Paragraph","id":"aca2693c6acf_2","name":"154d","type":"P","href":null,"layout":null,"metadata":null,"text":"Did you know that more than 200 million Instagrammers actively visit a business profile every day? That’s right, a study by Instagram revealed that the platform has become a destination where brands and businesses are not only discovered but where business is done. Instagram is no longer considered just a stop along the mobile journey, the platform is helping spur small business growth in big ways.","hasDropCap":true,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"A","start":115,"end":133,"href":"https:\u002F\u002Fbusiness.instagram.com\u002Fblog\u002F25-million-businesses\u002F","anchorType":"LINK","userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:aca2693c6acf_3":{"__typename":"Paragraph","id":"aca2693c6acf_3","name":"410c","type":"P","href":null,"layout":null,"metadata":null,"text":"With only milliseconds to capture our audiences’ attention, we are finding ourselves in a constant battle to try and organically connect them with our products and services that pique their interest. You may have good content but at the end of the day, your Instagram profile is what makes people stay.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:aca2693c6acf_4":{"__typename":"Paragraph","id":"aca2693c6acf_4","name":"8108","type":"P","href":null,"layout":null,"metadata":null,"text":"Before you tackle the content of your posts here are 5 easy ways to improve your Instagram profile so that it helps your audience connect with you from the moment someone lands on your page!","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:aca2693c6acf_5":{"__typename":"Paragraph","id":"aca2693c6acf_5","name":"0bc9","type":"H3","href":null,"layout":null,"metadata":null,"text":"1. Write an Instagram bio that pulls your audience in","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":53,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:aca2693c6acf_6":{"__typename":"Paragraph","id":"aca2693c6acf_6","name":"b3e5","type":"P","href":null,"layout":null,"metadata":null,"text":"Your Instagram bio is one of the most important parts of your Instagram page. It is the FIRST thing your audience sees when visiting your profile and that is why it is important to put effort into writing an Instagram bio that will set up your Instagram account for massive success.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:aca2693c6acf_7":{"__typename":"Paragraph","id":"aca2693c6acf_7","name":"614c","type":"P","href":null,"layout":null,"metadata":null,"text":"This blog post by Hootsuite gives away many valuable ideas, tips and examples on how to write the perfect Instagram bio. A few of these tips include:","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"A","start":0,"end":4,"href":"https:\u002F\u002Fblog.hootsuite.com\u002Finstagram-bio-ideas-business\u002F","anchorType":"LINK","userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:aca2693c6acf_8":{"__typename":"Paragraph","id":"aca2693c6acf_8","name":"ad31","type":"ULI","href":null,"layout":null,"metadata":null,"text":"Telling people exactly who you are and what they can expect from you in just a few statements","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:aca2693c6acf_9":{"__typename":"Paragraph","id":"aca2693c6acf_9","name":"1986","type":"ULI","href":null,"layout":null,"metadata":null,"text":"Including a branded hashtag to build a conversation around your brand","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:aca2693c6acf_10":{"__typename":"Paragraph","id":"aca2693c6acf_10","name":"729d","type":"ULI","href":null,"layout":null,"metadata":null,"text":"Using emojis to highlight your personality","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:aca2693c6acf_11":{"__typename":"Paragraph","id":"aca2693c6acf_11","name":"0edb","type":"P","href":null,"layout":null,"metadata":null,"text":"To find out more valuable tips and tricks, click here.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"A","start":43,"end":54,"href":"https:\u002F\u002Fblog.hootsuite.com\u002Finstagram-bio-ideas-business\u002F","anchorType":"LINK","userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:aca2693c6acf_12":{"__typename":"Paragraph","id":"aca2693c6acf_12","name":"de40","type":"H3","href":null,"layout":null,"metadata":null,"text":"2. Make sure your profile picture represents YOU","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":3,"end":48,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:aca2693c6acf_13":{"__typename":"Paragraph","id":"aca2693c6acf_13","name":"4559","type":"P","href":null,"layout":null,"metadata":null,"text":"First thing’s first: your profile picture says a lot about yourself. They say a picture is worth 1000 words and that couldn’t be more true in this case. As someone who is promoting their personal brand, you want to use an image of yourself — a clear headshot to be precise. Invite your followers in by choosing a headshot which shows off your huge smile! For brands, it is important to show off your logo, as clear as possible. If there is confusion between your brand and your Instagram feed, your audience might get lost in translation which could result in fewer leads!","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:aca2693c6acf_14":{"__typename":"Paragraph","id":"aca2693c6acf_14","name":"39b4","type":"P","href":null,"layout":null,"metadata":null,"text":"Business Mentor, Nesha Woolery shows off her big smile in her Instagram profile, which immediately invites us in and makes us want to have a look at her content!","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"A","start":17,"end":30,"href":"https:\u002F\u002Fwww.instagram.com\u002Fneshawoolery\u002F","anchorType":"LINK","userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*l7F-_AoX54OHi0tAbJVBlg.jpeg":{"__typename":"ImageMetadata","id":"1*l7F-_AoX54OHi0tAbJVBlg.jpeg","originalHeight":1332,"originalWidth":739,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:aca2693c6acf_15":{"__typename":"Paragraph","id":"aca2693c6acf_15","name":"24c1","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*l7F-_AoX54OHi0tAbJVBlg.jpeg"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:aca2693c6acf_16":{"__typename":"Paragraph","id":"aca2693c6acf_16","name":"1246","type":"H3","href":null,"layout":null,"metadata":null,"text":"3. Optimise your headline","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":3,"end":25,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:aca2693c6acf_17":{"__typename":"Paragraph","id":"aca2693c6acf_17","name":"a397","type":"P","href":null,"layout":null,"metadata":null,"text":"The bold headline in your Instagram bio is the name field which is searchable. That is why it is important to optimise it using a keyword which describes your particular niche. Using your name here is key because people want to know who they are following or connecting with. Everything is in your name, whether it be your business name or personal name — it is a key element to your Instagram profile page. One thing we suggest to our clients is using a consistent name across every social network. This makes it much easier for potential clients to find you and keeps your brand both personal and professional!","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:aca2693c6acf_18":{"__typename":"Paragraph","id":"aca2693c6acf_18","name":"67b3","type":"P","href":null,"layout":null,"metadata":null,"text":"Peggy Sue Organic Skincare does a great job of telling their audience exactly who they are using just their headline. By looking at their feed, it is clear that the brand is making a great attempt to communicate to their target audience as a sustainably made organic skincare brand in Australia.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"A","start":0,"end":27,"href":"https:\u002F\u002Fwww.instagram.com\u002Fpeggysuesoaps\u002F","anchorType":"LINK","userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*W00tfLcLbiaLPS3j91xyxQ.jpeg":{"__typename":"ImageMetadata","id":"1*W00tfLcLbiaLPS3j91xyxQ.jpeg","originalHeight":1380,"originalWidth":739,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:aca2693c6acf_19":{"__typename":"Paragraph","id":"aca2693c6acf_19","name":"506b","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*W00tfLcLbiaLPS3j91xyxQ.jpeg"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:aca2693c6acf_20":{"__typename":"Paragraph","id":"aca2693c6acf_20","name":"9edf","type":"H3","href":null,"layout":null,"metadata":null,"text":"4. Tell your brand story","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":3,"end":24,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:aca2693c6acf_21":{"__typename":"Paragraph","id":"aca2693c6acf_21","name":"d375","type":"P","href":null,"layout":null,"metadata":null,"text":"Your “story” is what makes people relate to you. Think of your Instagram profile as your website homepage, creating a long-lasting impression is everything! Make a great first impression by using Instagram’s story highlight feature to tell your story. By making it clear to your followers who you are as a person and what you have to offer at the very beginning is a great way to earn their valuable time and trust!","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:aca2693c6acf_22":{"__typename":"Paragraph","id":"aca2693c6acf_22","name":"1bbe","type":"P","href":null,"layout":null,"metadata":null,"text":"Business Coach, Morgan Rapp does a phenomenal job of telling her story. She has an Instagram highlight cover dedicated to her story about her life essentially and how she got to where she is today.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"A","start":16,"end":27,"href":"https:\u002F\u002Fwww.instagram.com\u002Fmorganrapp\u002F","anchorType":"LINK","userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*mA0FbX8wy7DaSaJuim7nYQ.jpeg":{"__typename":"ImageMetadata","id":"1*mA0FbX8wy7DaSaJuim7nYQ.jpeg","originalHeight":1356,"originalWidth":739,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:aca2693c6acf_23":{"__typename":"Paragraph","id":"aca2693c6acf_23","name":"dcaf","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*mA0FbX8wy7DaSaJuim7nYQ.jpeg"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:aca2693c6acf_24":{"__typename":"Paragraph","id":"aca2693c6acf_24","name":"6247","type":"H3","href":null,"layout":null,"metadata":null,"text":"5. Include a call to action","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":3,"end":27,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:aca2693c6acf_25":{"__typename":"Paragraph","id":"aca2693c6acf_25","name":"828f","type":"P","href":null,"layout":null,"metadata":null,"text":"Want to know exactly how your Instagram bio can make you shine? It’s simple! Leave your followers longing for more — or even better: give them a reason to want to get in contact with you. Instagram allows you to insert one clickable link into your bio so that you can link your audience to your prime content. This is such a great way to get people from your audience to view your content across a multitude of channels.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:aca2693c6acf_26":{"__typename":"Paragraph","id":"aca2693c6acf_26","name":"0989","type":"P","href":null,"layout":null,"metadata":null,"text":"Sarah, who is widely known for her @saltyluxe personal brand, has encouraged her audience to go and check out her website. In her bio, she has also included a call to action which encourages her fans to go and have a look at the sale that is currently taking place, with 30% off her presets. This is an example of how you can tell your fans to connect or engage with your brand, which is what Sarah does really well!","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"A","start":35,"end":45,"href":"https:\u002F\u002Fwww.instagram.com\u002Fsaltyluxe\u002F","anchorType":"LINK","userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*2uY4fRsqXrsRRMxP2K508A.jpeg":{"__typename":"ImageMetadata","id":"1*2uY4fRsqXrsRRMxP2K508A.jpeg","originalHeight":1420,"originalWidth":739,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:aca2693c6acf_27":{"__typename":"Paragraph","id":"aca2693c6acf_27","name":"3ad0","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*2uY4fRsqXrsRRMxP2K508A.jpeg"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:aca2693c6acf_28":{"__typename":"Paragraph","id":"aca2693c6acf_28","name":"de3a","type":"P","href":null,"layout":null,"metadata":null,"text":"Now that you have an idea of how to get your Instagram profile up to scratch, you can go on and have a look at brands in your niche for some further inspiration. It is important to note that every niche is different and when it comes to customising your Instagram profile, it is key to look at the top performers in your specific niche to get a good idea of the standard that has been set!","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:aca2693c6acf_29":{"__typename":"Paragraph","id":"aca2693c6acf_29","name":"a876","type":"P","href":null,"layout":null,"metadata":null,"text":"P.S If you want to dive deeper into your Instagram strategy, read this guide I wrote about how to use Instagram Hashtags!","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"A","start":66,"end"